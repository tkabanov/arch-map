{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arch-map:spec:1",
  "title": "arch-map spec document",
  "description": "One spec document of arch-map (docs/architecture.md AD-1..AD-9). Core objects are closed; only facets.* values and envelopes.* are open.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "elements",
    "edges"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "description": "Semver of this schema; the viewer accepts major 1 only. 1.1 adds `tiers` and the element type `bus`; 1.2 adds the edge's `via`; 1.3 adds `glyphs`.",
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/docName"
      }
    },
    "repos": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/repo"
      }
    },
    "tiers": {
      "description": "Since 1.1. The horizontal layers of the map, top-down, for the whole merged set: at most one list (documents that declare tiers must declare the same list). Without any, the four default tiers people, ui, service, data. An element's `tier` names one of them.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tier"
      }
    },
    "glyphs": {
      "description": "Since 1.3. How the map draws elements that carry a facet: the stack that emits a facet declares its glyph and role here, so the viewer names no facet (AD-13). Ordered: an element with several declared facets takes the first declaration of the merged set (documents in load order). A facet declared in two documents must be declared the same way. Elements without a declared facet fall back to their core type.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/glyph"
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "envelopes": {
      "description": "Keyed by contract object key (doc + JSON pointer, AD-7). Values are open.",
      "type": "object",
      "propertyNames": {
        "pattern": "^contracts/[A-Za-z0-9._-]+\\.json#/.+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "overrides": {
      "description": "Display overrides of elements of other documents (client layer only).",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/elementId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/override"
      }
    }
  },
  "$defs": {
    "docName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.json$"
    },
    "elementId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "methodName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_$]+$"
    },
    "edgeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*(#[A-Za-z0-9_$]+)?>[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*(#[A-Za-z0-9_$]+)?:[a-z]+$"
    },
    "elementType": {
      "enum": [
        "actor",
        "system",
        "app",
        "module",
        "component",
        "endpoint",
        "datastore",
        "table",
        "external-system",
        "job",
        "queue",
        "bus"
      ]
    },
    "tierId": {
      "description": "A tier id: one of the merged set's tiers (checked by merge).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "glyph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facet",
        "shape",
        "role"
      ],
      "properties": {
        "facet": {
          "description": "A facet key, as in an element's `facets`.",
          "type": "string",
          "pattern": "^[a-z0-9]+\\.[a-z0-9-]+$"
        },
        "shape": {
          "description": "The viewer's glyph drawn on the tile (a rail is not declarable: it comes from the core types bus, queue and job).",
          "enum": [
            "endpoints",
            "core",
            "stack",
            "grid",
            "orbit",
            "frame",
            "arrow",
            "person",
            "clock",
            "ring",
            "matrix"
          ]
        },
        "role": {
          "description": "What the element is, in a few words (shown on the card and the panel).",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/tierId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "channel": {
      "enum": [
        "interacts",
        "call",
        "import",
        "read",
        "write",
        "rest",
        "event",
        "webhook",
        "https",
        "smtp",
        "trigger",
        "schedule",
        "references"
      ]
    },
    "provenance": {
      "enum": [
        "extracted",
        "declared",
        "authored"
      ]
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "commit",
        "blob"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "blob": {
          "type": "string",
          "pattern": "\\{file\\}"
        }
      }
    },
    "codeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "file",
        "line"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "$ref": "#/$defs/line"
        }
      }
    },
    "configSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "string",
          "pattern": "^[^#]+#.+$"
        }
      }
    },
    "source": {
      "type": "object",
      "if": {
        "type": "object",
        "required": [
          "config"
        ]
      },
      "then": {
        "$ref": "#/$defs/configSource"
      },
      "else": {
        "$ref": "#/$defs/codeSource"
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "public",
            "authenticated",
            "restricted"
          ]
        },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "guards": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "policies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "pointer": {
      "type": "string",
      "pattern": "^#/(components/schemas|\\$defs)/[^/]+$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc"
      ],
      "properties": {
        "doc": {
          "type": "string",
          "pattern": "^contracts/[A-Za-z0-9._-]+\\.json$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/pointer"
        },
        "response": {
          "$ref": "#/$defs/pointer"
        }
      }
    },
    "facets": {
      "description": "Stack-specific detail; values are free objects.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+\\.[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/methodName"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expr",
              "line"
            ],
            "properties": {
              "expr": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "$ref": "#/$defs/line"
              }
            }
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "nullable",
        "pk"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        },
        "pk": {
          "type": "boolean"
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "file",
        "line"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "$ref": "#/$defs/line"
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "parent",
        "name",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/elementId"
        },
        "type": {
          "$ref": "#/$defs/elementType"
        },
        "parent": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/elementId"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "technology": {
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/tierId"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "context": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "derivedFrom": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "value"
          ],
          "properties": {
            "rule": {
              "enum": [
                "folder",
                "config",
                "prefix",
                "schema",
                "usage"
              ],
              "description": "How an inferred grouping was made: folder, config, prefix (a word of the names), schema, usage (what its parts use most; since 1.2)."
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/method"
          }
        },
        "handler": {
          "$ref": "#/$defs/methodName"
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "path"
          ],
          "properties": {
            "method": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "HEAD",
                "OPTIONS"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "contains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/elementId"
          }
        },
        "facets": {
          "$ref": "#/$defs/facets"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "app",
                  "datastore"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "parent": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "app"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "tier"
            ]
          }
        },
        {
          "$ref": "#/$defs/only-methods"
        },
        {
          "$ref": "#/$defs/only-handler"
        },
        {
          "$ref": "#/$defs/only-http"
        },
        {
          "$ref": "#/$defs/only-columns"
        },
        {
          "$ref": "#/$defs/only-access"
        },
        {
          "$ref": "#/$defs/only-contract"
        },
        {
          "$ref": "#/$defs/only-contains"
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "provenance": {
                "const": "declared"
              }
            },
            "required": [
              "provenance",
              "source"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "source": {
                "$ref": "#/$defs/configSource"
              }
            }
          }
        }
      ]
    },
    "only-methods": {
      "if": {
        "type": "object",
        "required": [
          "methods"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "type": {
            "const": "component"
          }
        }
      }
    },
    "only-handler": {
      "if": {
        "type": "object",
        "required": [
          "handler"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "type": {
            "const": "endpoint"
          }
        }
      }
    },
    "only-http": {
      "if": {
        "type": "object",
        "required": [
          "http"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "type": {
            "const": "endpoint"
          }
        }
      }
    },
    "only-columns": {
      "if": {
        "type": "object",
        "required": [
          "columns"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "type": {
            "const": "table"
          }
        }
      }
    },
    "only-access": {
      "if": {
        "type": "object",
        "required": [
          "access"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "type": {
            "const": "endpoint"
          }
        }
      }
    },
    "only-contract": {
      "if": {
        "type": "object",
        "required": [
          "contract"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "type": {
            "const": "endpoint"
          }
        }
      }
    },
    "only-contains": {
      "if": {
        "type": "object",
        "required": [
          "contains"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "type": {
            "const": "system"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "channel",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/edgeId"
        },
        "from": {
          "$ref": "#/$defs/elementId"
        },
        "to": {
          "$ref": "#/$defs/elementId"
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "fromMethod": {
          "$ref": "#/$defs/methodName"
        },
        "toMethod": {
          "$ref": "#/$defs/methodName"
        },
        "via": {
          "description": "The elements this relation physically passes through, in order (an API gateway, an API server): the relation itself is what the code does (a function writes a table); `via` is how it travels (gateway → PostgREST → Postgres). The map draws it along them; core questions ignore it.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/elementId"
          }
        },
        "label": {
          "type": "string"
        },
        "ops": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "context": {
          "type": "boolean"
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "facets": {
          "$ref": "#/$defs/facets"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "ops"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "channel": {
                "enum": [
                  "read",
                  "write",
                  "references",
                  "https",
                  "smtp"
                ]
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "provenance": {
                "const": "declared"
              }
            },
            "required": [
              "provenance",
              "source"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "source": {
                "$ref": "#/$defs/configSource"
              }
            }
          }
        }
      ]
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/elementId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "if": {
        "type": "object",
        "required": [
          "element"
        ]
      },
      "then": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caption",
          "element"
        ],
        "properties": {
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "element": {
            "$ref": "#/$defs/elementId"
          },
          "duration": {
            "description": "Seconds the step stays on screen when the scenario plays (cinema). Default: by the caption's length.",
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 120
          }
        }
      },
      "else": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caption",
          "from",
          "to"
        ],
        "properties": {
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "$ref": "#/$defs/elementId"
          },
          "to": {
            "$ref": "#/$defs/elementId"
          },
          "channel": {
            "$ref": "#/$defs/channel"
          },
          "contract": {
            "$ref": "#/$defs/contract"
          },
          "duration": {
            "description": "Seconds the step stays on screen when the scenario plays (cinema). Default: by the caption's length.",
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 120
          }
        }
      }
    }
  }
}
