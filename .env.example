# arch-map reads these from .env.local (gitignored; every npm script loads it with --env-file-if-exists).

# The projects directory: index.json plus one folder per project (project.json, its code, sources, tests and specs/).
# Absolute, or relative to this checkout. Unset: examples/ of this repo.
ARCH_MAP_PROJECTS=/path/to/projects

# Each project declares the variables it reads (the target checkouts, snapshot inputs) in <project>/project.json#env;
# a projects directory may keep its own .env.example listing them. They go into this same .env.local.
