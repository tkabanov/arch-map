{
  "name": "arch-map",
  "private": true,
  "type": "module",
  "exports": {
    "./stacks/nest": "./scripts/stacks/nest/index.ts",
    "./stacks/supabase": "./scripts/stacks/supabase/index.ts",
    "./generator": "./scripts/lib/generator.ts",
    "./testing": "./scripts/lib/testing.ts",
    "./cli/check-specs": "./scripts/check-specs.ts",
    "./cli/check-boundary": "./scripts/check-boundary.ts",
    "./core": "./viewer/src/core/index.ts",
    "./viewer/model": "./viewer/src/model.ts",
    "./viewer/spec-adapter": "./viewer/src/spec-adapter.ts",
    "./viewer/layout": "./viewer/src/layout.ts",
    "./viewer/scenario": "./viewer/src/scenario.ts",
    "./viewer/envelopes": "./viewer/src/envelopes.ts",
    "./types/spec": "./types/spec.d.ts",
    "./types/*": "./types/*.ts",
    "./tsconfig.json": "./tsconfig.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen": "node --env-file-if-exists=.env.local scripts/run.ts gen",
    "snapshot": "node --env-file-if-exists=.env.local scripts/run.ts snapshot",
    "check": "node --env-file-if-exists=.env.local scripts/check-specs.ts",
    "check:determinism": "node --env-file-if-exists=.env.local scripts/check-determinism.ts",
    "test": "node --env-file-if-exists=.env.local scripts/test.ts",
    "test:browser": "node --env-file-if-exists=.env.local scripts/test-browser.ts",
    "viewer": "node --env-file-if-exists=.env.local scripts/publish-specs.ts && vite viewer --port 4848 --strictPort",
    "viewer:build": "node --env-file-if-exists=.env.local scripts/publish-specs.ts && vite build viewer --outDir dist --emptyOutDir",
    "check:boundary": "node --env-file-if-exists=.env.local scripts/check-boundary.ts",
    "viewer:preview": "vite preview viewer --outDir dist --port 4848 --strictPort",
    "lib:build": "node scripts/build-lib.ts",
    "lib:pack": "node scripts/build-lib.ts --pack",
    "types": "node scripts/gen-types.ts",
    "check:types": "node scripts/gen-types.ts --check",
    "check:tsc": "node --env-file-if-exists=.env.local scripts/check-tsc.ts",
    "lint": "eslint . --pass-on-unpruned-suppressions",
    "check:warnings": "node scripts/check-lint-warnings.ts",
    "lint:prune": "eslint . --prune-suppressions",
    "check:neutral": "node --env-file-if-exists=.env.local scripts/check-neutral.ts",
    "check:arch": "node --env-file-if-exists=.env.local scripts/check-arch.ts",
    "quality:report": "node scripts/quality-report.ts",
    "check:all": "node scripts/check-all.ts",
    "check:fast": "node scripts/check-all.ts --fast"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/three": "0.186.0",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "json-schema-to-typescript": "16.0.0",
    "libpg-query": "18.1.5",
    "playwright-core": "1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.186.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  },
  "license": "MIT"
}
